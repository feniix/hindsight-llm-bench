# Hindsight server environment for the bench containers. Copy to server.env.
# Match your real install's settings so the bench measures what you run; the
# values below are the ones used for the published comparison.
# The scripts set the model under test (HINDSIGHT_API_<OP>_LLM_MODEL) per run.

HINDSIGHT_API_LLM_PROVIDER=openai-codex
HINDSIGHT_API_LLM_MODEL=gpt-5.6-luna
HINDSIGHT_API_LLM_REASONING_EFFORT=low
HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=English
# Route every Codex call through proxy/codex_proxy.py (PROXY_PORT).
HINDSIGHT_API_LLM_BASE_URL=http://host.docker.internal:8090/backend-api
CODEX_HOME=/home/hindsight/codex-auth

HINDSIGHT_API_REFLECT_LLM_TIMEOUT=180
HINDSIGHT_API_MENTAL_MODEL_MIN_REFRESH_INTERVAL_SECONDS=3600

HINDSIGHT_API_RETAIN_MISSION=Focus on technical decisions, architecture choices, project conventions, tooling setup, and recurring gotchas. Deprioritize transient debugging chatter.
HINDSIGHT_API_RETAIN_EXTRACTION_MODE=concise
HINDSIGHT_API_RETAIN_BATCH_ENABLED=false

# Reranker: use whatever your real install uses. Ours was a host-side
# TEI-compatible server with a local fallback.
HINDSIGHT_API_RERANKER_PROVIDER=tei
HINDSIGHT_API_RERANKER_TEI_URL=http://host.docker.internal:8081
HINDSIGHT_API_RERANKER_1_PROVIDER=local
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=100

# Keep full prompts and outputs in llm_requests for the trace export.
HINDSIGHT_API_LLM_TRACE_MAX_CHARS=2000000
HINDSIGHT_API_LLM_TRACE_RETENTION_DAYS=30

# Bench-only: no background work, so every model reads the same memory.
HINDSIGHT_API_WORKER_ENABLED=false
HINDSIGHT_API_WORKER_ID=hindsight-bench
HINDSIGHT_API_HOST=0.0.0.0
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_LOG_LEVEL=info
HINDSIGHT_ENABLE_CP=false
