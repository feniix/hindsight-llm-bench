# Copy to config.env and edit. scripts/common.sh loads it; every value has a default.

# Working directory: inputs, runs, pairs, logs, the Codex login. Git-ignored.
BENCH_WORK=./work

# Hindsight image under test. Pin a version or digest.
HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight:0.10.2

# The throwaway bench container. It never shares a volume with your real install.
BENCH_CONTAINER=hindsight-bench
BENCH_VOLUME=hindsight-bench-db
BENCH_PORT=18888
HINDSIGHT_BENCH_URL=http://localhost:18888

# Downstream follow-up container (fresh, empty volume).
FU_CONTAINER=hindsight-fu
FU_VOLUME=hindsight-fu-db

# Your real install, read only by prepare/export.py (GET requests only).
HINDSIGHT_SOURCE_URL=http://localhost:8888

# A `hindsight-admin backup` zip of the source install, restored into the bench.
BACKUP_ZIP=./work/banks.zip

# Server environment for the bench containers (see server.example.env).
SERVER_ENV=./server.env

# Codex login used only by the bench. Log in once with:
#   CODEX_HOME=./work/codex-auth codex login
# Never copy your real install's login: two installs refreshing one token
# invalidate each other.
CODEX_AUTH_DIR=./work/codex-auth

# Logging proxy for exact Codex token usage (proxy/codex_proxy.py).
PROXY_PORT=8090

# Seconds to wait after a container is healthy before measuring.
SETTLE_SECONDS=20

# Judges and graders (only for the scoring steps).
# GEMINI_API_KEY=...
# TYPESAFE_API_KEY=...
